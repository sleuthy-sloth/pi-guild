{
  "name": "pi-studio",
  "version": "0.1.0",
  "description": "Turn Pi into an autonomous multi-agent software-development organization. Native Pi runtime, local-first, SQLite persistence.",
  "license": "MIT",
  "type": "module",
  "keywords": ["pi-package", "pi", "agents", "orchestration", "multi-agent", "autonomous"],
  "engines": {
    "node": ">=22.5.0"
